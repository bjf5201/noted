NODE_ENV=development
CAN_CREATE_DATABASE=1
CAN_SEED_DATABASE=1
CAN_DROP_DATABASE=1

# Database
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=test_db

# Server
FASTIFY_HOST=0.0.0.0
FASTIFY_PORT=3000
FASITFY_CLOSE_GRACE_DELAY=1000
LOG_LEVEL=info

# Security
SECRET_KEY_JWT=
COOKIE_SECRET=
COOKIE_NAME=session_id
RATE_LIMIT_MAX=4 # Increase if you need more for prod