{
  "name": "noted",
  "author": "Bethany Fannin <contact@bethanyfannin.com> (https://www.bethanyfannin.com)",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "description": "",
  "keywords": [
    "notes",
    "markdown",
    "typescript",
    "infrastructure-as-code",
    "iac",
    "terraform",
    "fastify"
  ],
  "repository": {
    "type": "git",
    "url": "git+github.com:bjf5201/noted.git"
  },
  "bugs": {
    "url": "https://github.com/bjf5201/noted/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*",
    "./#/*": "./test/*"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "dev": "tsx watch --env-file=.env.development.local src/server.ts",
    "start": "tsx --env-file=.env.development.local src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint . --cache --no-error-on-unmatched-pattern",
    "lint": "eslint . --fix --cache --no-warn-ignored --max-warnings 0 --no-error-on-unmatched-pattern",
    "format:check": "prettier \"**/*\" --check --ignore-unknown --cache",
    "format": "prettier \"**/*\" --write --ignore-unknown --cache",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format",
    "test": "tsx --env-file=.env.development.local --test **/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:create": "tsx --env-file=.env.development ./scripts/create-database.ts",
    "db:drop": "tsx --env-file=.env.development ./scripts/drop-database.ts",
    "db:migrate": "tsx --env-file=.env.development ./scripts/migrate-database.ts",
    "db:seed": "tsx --env-file=.env.development ./scripts/seed-database.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/env": "^7.0.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/session": "^11.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "close-with-grace": "^2.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "c8": "^12.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
