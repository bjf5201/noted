# TODO: make .env default dev env, set explicit .env.production for production
NODE_ENV=production
CAN_CREATE_DATABASE=1
CAN_SEED_DATABASE=1
CAN_DROP_DATABASE=1

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=noted

# Server
FASTIFY_HOST=0.0.0.0
FASTIFY_PORT=3000
FASITFY_CLOSE_GRACE_DELAY=1000
LOG_LEVEL=info

# Security
COOKEI_SECRET=
COOKIE_NAME=session_id
RATE_LIMIT_MAX=4 # Increase if you need more for prod